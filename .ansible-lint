---
# ansible-lint — realistic baseline for the current codebase.
# (modules still use short names instead of FQCN)
profile: moderate
offline: true
verbosity: 1

# fqcn[action-core] would fail on the existing roles (command, copy, service...).
# Kept as a warning until the FQCN migration; all other rules fail the build.
warn_list:
  - fqcn

# var-name[no-role-prefix] is intentionally skipped: the existing registers
# (rke2_binary, verify_nodes, ...) predate the prefix convention and renaming
# them all is out of scope. New code should still use role-prefixed names.
skip_list:
  - var-name

exclude_paths:
  - .git/
  - .github/
  - rke2-artifacts/
