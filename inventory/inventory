# ============================================================
# Ansible Inventory for RKE2 Cluster
# Production Environment
# ============================================================

[all:children]
control_plane
workers

[all:vars]
ansible_connection=ssh
ansible_user=ubuntu
ansible_become=true
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
ansible_ssh_private_key_file=~/.ssh/id_rsa

[control_plane]
rke2-cp-01 ansible_host=192.168.122.10
rke2-cp-01 rke2_role=server

[workers]
rke2-worker-01 ansible_host=192.168.122.11
rke2-worker-01 rke2_role=agent
